{
  "name": "liturgia",
  "version": "2.0.0",
  "description": "Sacred ministry roster for St. Mathias English Community",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "nodemon server/index.js",
    "client": "cd client && npm run dev",
    "build": "cd client && npm install --include=dev && npm run build",
    "build:apk": "powershell -ExecutionPolicy Bypass -File scripts/build-android-apk.ps1",
    "install-all": "npm install && cd client && npm install",
    "migrate-to-postgres": "node scripts/migrate-sqlite-to-postgres.js",
    "postinstall": "cd client && npm install --include=dev"
  },
  "keywords": ["liturgy", "church", "readers"],
  "license": "MIT",
  "dependencies": {
    "body-parser": "^1.20.2",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "pg": "^8.11.3",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "nodemon": "^3.0.2"
  }
}
