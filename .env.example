# Local dev uses liturgia.db (SQLite) when DATABASE_URL is unset.
# For Neon / Render, set DATABASE_URL to your PostgreSQL connection string:
# DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

PORT=3000
NODE_ENV=development

# Android APK builds (optional — set to your Render URL after deploy)
# VITE_API_URL=https://liturgia.onrender.com/api
